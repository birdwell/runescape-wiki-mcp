{
  "name": "runescape-wiki-mcp",
  "version": "1.2.0",
  "description": "Ask an assistant for RS3 Grand Exchange guide prices, 7-90 day trends, flip profit after the 2% tax, normal-mode hiscores, and wiki pages. Prices lag the live market.",
  "mcpName": "io.github.birdwell/runescape-wiki-mcp",
  "bin": {
    "runescape-wiki-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdwell/runescape-wiki-mcp.git"
  },
  "homepage": "https://runescape-wiki-mcp.fly.dev",
  "bugs": {
    "url": "https://github.com/birdwell/runescape-wiki-mcp/issues"
  },
  "main": "dist/index.js",
  "module": "src/smithery.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:server-card": "tsc && node scripts/build-server-card.mjs",
    "dev": "tsc --watch & node --watch dist/index.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "debug": "DEBUG=true node dist/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:verbose": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "inspector": "bunx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "tsc",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "fly:deploy": "fly deploy --ha=false"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "runescape",
    "runescape3",
    "rs3",
    "runescape-wiki",
    "grand-exchange",
    "ai-agent",
    "gaming"
  ],
  "author": "Josh Birdwell",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sentry/node": "^11.9.0",
    "htmlparser2": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smithery/cli": "^4.11.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "nock": "^15.0.5",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.4.3"
}
