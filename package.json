{
  "name": "runescape-wiki-mcp",
  "version": "1.2.0",
  "description": "RuneScape 3 MCP server for Grand Exchange prices, item comparisons, flip estimates, player hiscores, and wiki pages.",
  "mcpName": "io.github.birdwell/runescape-wiki-mcp",
  "bin": {
    "runescape-wiki-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdwell/runescape-wiki-mcp.git"
  },
  "homepage": "https://runescape-wiki-mcp.fly.dev",
  "bugs": {
    "url": "https://github.com/birdwell/runescape-wiki-mcp/issues"
  },
  "main": "dist/index.js",
  "module": "src/smithery.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch & node --watch dist/index.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "debug": "DEBUG=true node dist/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:verbose": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "inspector": "bunx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "tsc",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "fly:deploy": "fly deploy --ha=false"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "runescape",
    "runescape3",
    "rs3",
    "runescape-wiki",
    "grand-exchange",
    "ai-agent",
    "gaming"
  ],
  "author": "Josh Birdwell",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sentry/node": "^11.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@smithery/cli": "^4.11.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.4.2",
    "nock": "^14.0.15",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.4.3"
}
