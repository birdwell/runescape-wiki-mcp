  "charts": [
    {
      "name": "Tool calls per day",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "series": [
            {
              "kind": "EventsNode",
              "event": "rs_mcp_tool_call",
              "math": "total",
              "properties": [
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "production"
                  ]
                },
                {
                  "key": "transport",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "http"
                  ]
                }
              ]
            }
          ],
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "breakdownFilter": {
            "breakdowns": [
              {
                "property": "tool_name",
                "type": "event"
              }
            ]
          },
          "trendsFilter": {
            "display": "ActionsLineGraph",
            "showLegend": true
          }
        }
      }
